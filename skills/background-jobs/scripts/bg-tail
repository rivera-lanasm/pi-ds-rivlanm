#!/usr/bin/env bash
#
# bg-tail — print the end of a job log.
#
# Usage: bg-tail [--err] [--lines N] JOB_ID
#
# Reads stdout.log by default and stderr.log with --err. Prints the last 50
# lines unless --lines gives another count.
#
# Read the end of a log, not the whole file. Run bg-status first to see how
# large the log is.

set -euo pipefail

readonly jobs_root="${PI_JOBS_DIR:-$HOME/.pi/jobs}"

usage() {
  cat >&2 <<'EOF'
Usage: bg-tail [--err] [--lines N] JOB_ID

  --err         Read stderr.log instead of stdout.log.
  --lines N     Number of lines to print. Default 50.
EOF
  exit 2
}

log_name="stdout.log"
line_count=50

while [ "$#" -gt 0 ]; do
  case "$1" in
    --err)
      log_name="stderr.log"
      shift
      ;;
    --lines)
      [ "$#" -ge 2 ] || usage
      line_count="$2"
      shift 2
      ;;
    -h | --help) usage ;;
    -*) usage ;;
    *) break ;;
  esac
done

[ "$#" -eq 1 ] || usage

case "$line_count" in
  '' | *[!0-9]*) usage ;;
esac

log_file="${jobs_root}/$1/${log_name}"
if [ ! -f "$log_file" ]; then
  printf 'bg-tail: no such log: %s\n' "$log_file" >&2
  exit 1
fi

tail -n "$line_count" -- "$log_file"
