#!/usr/bin/env bash
#
# bg-start — start a command in the background and create its job directory.
#
# Usage: bg-start [--name NAME] -- COMMAND [ARG...]
#
# Creates $PI_JOBS_DIR/<job-id>/ (default ~/.pi/jobs), launches COMMAND detached
# from this shell, and prints the job id. The command keeps running after this
# script exits and after the calling tool call returns.
#
# The job runs in its own process group so bg-stop can signal the whole tree.
# Its stdin is /dev/null, so a command that reads a prompt fails fast instead
# of blocking forever.

set -euo pipefail

readonly jobs_root="${PI_JOBS_DIR:-$HOME/.pi/jobs}"
readonly pid_wait_deciseconds=50

usage() {
  cat >&2 <<'EOF'
Usage: bg-start [--name NAME] -- COMMAND [ARG...]

  --name NAME   Label used as the first part of the job id.
                Defaults to the name of the command.

Prints the job id on stdout.
EOF
  exit 2
}

job_name=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --name)
      [ "$#" -ge 2 ] || usage
      job_name="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -h | --help) usage ;;
    *) usage ;;
  esac
done

[ "$#" -ge 1 ] || usage

if [ -z "$job_name" ]; then
  job_name="$(basename -- "$1")"
fi
# Keep the id safe to use as a directory name.
job_name="$(printf '%s' "$job_name" | tr -c 'A-Za-z0-9._-' '-')"

job_id="${job_name}-$(date -u +%Y%m%d-%H%M%S)-$$"
mkdir -p -- "${jobs_root}/${job_id}"

# The jobs directory excludes itself, so no repository .gitignore is edited.
if [ ! -f "${jobs_root}/.gitignore" ]; then
  printf '*\n' >"${jobs_root}/.gitignore"
fi

# Absolute, so the job is unaffected by any later change of directory.
job_dir="$(cd -- "${jobs_root}/${job_id}" && pwd)"

printf '%s\n' "$PWD" >"${job_dir}/cwd"
date -u +%Y-%m-%dT%H:%M:%SZ >"${job_dir}/started_at"
{
  printf '%q ' "$@"
  printf '\n'
} >"${job_dir}/cmd"
: >"${job_dir}/stdout.log"
: >"${job_dir}/stderr.log"

# The wrapper records its own pid, which under setsid is the process group id.
# It writes the exit code through a temporary file, so a reader never sees a
# half-written exit file. The wrapper does not use `set -e`: a failing command
# must still reach the line that records its code.
setsid bash -c '
  job_dir="$1"
  shift
  printf "%s\n" "$$" >"${job_dir}/pid"
  "$@" >"${job_dir}/stdout.log" 2>"${job_dir}/stderr.log"
  code=$?
  printf "%s\n" "$code" >"${job_dir}/exit.tmp"
  mv -- "${job_dir}/exit.tmp" "${job_dir}/exit"
' bash "$job_dir" "$@" </dev/null >/dev/null 2>&1 &

# Wait for the job to register, so a caller never sees a half-created job.
# A command that fails immediately writes exit before it ever writes pid.
waited=0
while [ "$waited" -lt "$pid_wait_deciseconds" ]; do
  if [ -s "${job_dir}/pid" ] || [ -f "${job_dir}/exit" ]; then
    break
  fi
  sleep 0.1
  waited=$((waited + 1))
done

printf '%s\n' "$job_id"
