#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Set up and check a workspace.

Boundary script: reads and creates files in the workspace and runs `git` to
test the repositories. With --init the script creates the workspace
skeleton and never overwrites an existing file. Without --init the script
checks the workspace against the layout and against workspace.toml.

Usage:
    tw-check [path]          check the workspace (default: current directory)
    tw-check --init [path]   create the skeleton, then check
"""

import re
import subprocess
import sys
from collections.abc import Sequence
from dataclasses import dataclass
from pathlib import Path
from typing import Literal

import tomllib

DIRECTORIES = ("research", "proposals", "conclusions", "scratch", "repos")

# Keep in sync with tw-close.
REQUIRED_SECTIONS = (
    "Goal",
    "Progress",
    "Done",
    "Decisions",
    "Artifacts",
    "Open items",
)

Severity = Literal["error", "warning", "note"]

AGENTS_STUB = """\
# AGENTS.md — {name} workspace

Project: {name}

This file holds the session rules for the workspace. The workspace skill
holds the procedure. Fill in the commands and the hard rules: start from
references/agents-md-template.md in the workspace skill.
"""

TOML_STUB = """\
project = "{name}"

[repos]
# work = ["repo-one"]
# context = ["repo-two"]
"""


@dataclass(frozen=True)
class Config:
    """The declared parts of a workspace, from workspace.toml."""

    project: str | None
    repos: tuple[str, ...]


@dataclass(frozen=True)
class Finding:
    """One check result: a severity and a one-line message."""

    severity: Severity
    message: str


def load_config(root: Path) -> Config | None:
    """Return the declared config, or None when the file does not exist.

    Raises ValueError when the file does not parse or a value has the wrong
    type.
    """
    path = root / "workspace.toml"
    if not path.is_file():
        return None
    try:
        data = tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError as error:
        raise ValueError(f"workspace.toml: {error}") from None
    project = data.get("project")
    repos = data.get("repos", {})
    if project is not None and not isinstance(project, str):
        raise ValueError("workspace.toml: project must be a string")
    if isinstance(repos, list):
        raise ValueError(
            "workspace.toml: repos must be a table with 'work' and 'context' "
            "lists; the list form was removed. See references/workspace.md."
        )
    if not isinstance(repos, dict):
        raise ValueError("workspace.toml: repos must be a table")
    names = []
    for role in ("work", "context"):
        values = repos.get(role, [])
        if not isinstance(values, list) or not all(isinstance(r, str) for r in values):
            raise ValueError(f"workspace.toml: repos.{role} must be a list of strings")
        names.extend(values)
    return Config(project=project, repos=tuple(names))


def git_toplevel(path: Path) -> Path | None:
    """Return the top level of the git repository that holds path, or None."""
    result = subprocess.run(
        ["git", "-C", str(path), "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=False,
        stdin=subprocess.DEVNULL,
    )
    return Path(result.stdout.strip()) if result.returncode == 0 else None


def check_root(root: Path) -> list[Finding]:
    """Warn when the workspace root sits inside a git repository."""
    toplevel = git_toplevel(root)
    if toplevel is None:
        return []
    return [
        Finding(
            "warning",
            f"the workspace root is inside the git repository {toplevel}",
        )
    ]


def check_agents_md(root: Path, config: Config | None) -> list[Finding]:
    """Check that AGENTS.md exists and declares the project name."""
    path = root / "AGENTS.md"
    if not path.is_file():
        return [Finding("error", "AGENTS.md: no file")]
    match = re.search(r"^Project: *(\S+)", path.read_text(), flags=re.MULTILINE)
    if match is None:
        return [Finding("warning", "AGENTS.md: no 'Project:' line")]
    declared = match.group(1)
    if config and config.project and declared != config.project:
        return [
            Finding(
                "error",
                f"AGENTS.md declares project '{declared}', "
                f"workspace.toml declares '{config.project}'",
            )
        ]
    return []


def check_directories(root: Path) -> list[Finding]:
    """Warn when a layout directory is missing."""
    return [
        Finding("warning", f"{name}/: no directory")
        for name in DIRECTORIES
        if not (root / name).is_dir()
    ]


def check_repos(root: Path, config: Config) -> list[Finding]:
    """Check that each declared repository exists under repos/ and is a git repository."""
    findings = []
    for name in config.repos:
        path = root / "repos" / name
        if not path.is_dir():
            findings.append(Finding("error", f"repo {name}: no directory at repos/{name}"))
        elif git_toplevel(path) is None:
            findings.append(Finding("error", f"repo {name}: not a git repository"))
    return findings


def check_repos_undeclared(root: Path, config: Config) -> list[Finding]:
    """Note a directory in repos/ that no role declares."""
    directory = root / "repos"
    if not directory.is_dir():
        return []
    declared = set(config.repos)
    return [
        Finding("note", f"repo {path.name}: no role declares it in workspace.toml")
        for path in sorted(directory.iterdir())
        if path.is_dir() and not path.name.startswith(".") and path.name not in declared
    ]


def check_proposals(root: Path) -> list[Finding]:
    """Warn when a proposal document has no current HTML rendering."""
    directory = root / "proposals"
    if not directory.is_dir():
        return []
    findings = []
    for source in sorted(directory.glob("*.md")):
        rendering = source.with_suffix(".html")
        stale = (
            not rendering.is_file()
            or rendering.stat().st_mtime < source.stat().st_mtime
        )
        if stale:
            findings.append(
                Finding("warning", f"proposal {source.name}: no current HTML")
            )
    return findings


def check_conclusions(root: Path) -> list[Finding]:
    """Warn when a conclusion document misses a required section."""
    directory = root / "conclusions"
    if not directory.is_dir():
        return []
    findings = []
    for document in sorted(directory.glob("*.md")):
        headings = set(
            re.findall(r"^## (.+)$", document.read_text(), flags=re.MULTILINE)
        )
        missing = [name for name in REQUIRED_SECTIONS if name not in headings]
        if missing:
            findings.append(
                Finding(
                    "warning",
                    f"conclusion {document.name}: "
                    f"missing sections {', '.join(missing)}",
                )
            )
    return findings


def run_checks(root: Path, config: Config | None) -> list[Finding]:
    """Run every check and return the findings."""
    findings = (
        check_root(root)
        + check_agents_md(root, config)
        + check_directories(root)
        + check_proposals(root)
        + check_conclusions(root)
    )
    if config is None:
        findings.append(Finding("note", "no workspace.toml: declared checks skipped"))
        return findings
    return (
        findings
        + check_repos(root, config)
        + check_repos_undeclared(root, config)
    )


def init_workspace(root: Path) -> list[str]:
    """Create the workspace skeleton and return one outcome line per item.

    Existing files and directories are kept, so a second run changes
    nothing.
    """
    root.mkdir(parents=True, exist_ok=True)
    outcomes = []
    for name in DIRECTORIES:
        path = root / name
        if path.is_dir():
            outcomes.append(f"kept: {name}/")
        else:
            path.mkdir()
            outcomes.append(f"created: {name}/")
    stubs = (("AGENTS.md", AGENTS_STUB), ("workspace.toml", TOML_STUB))
    for filename, template in stubs:
        path = root / filename
        if path.exists():
            outcomes.append(f"kept: {filename}")
        else:
            path.write_text(template.format(name=root.name))
            outcomes.append(f"created: {filename}")
    return outcomes


def main(argv: Sequence[str]) -> int:
    """Set up or check a workspace and return the exit code."""
    init = "--init" in argv
    arguments = [argument for argument in argv if argument != "--init"]
    if len(arguments) > 1:
        print("usage: tw-check [--init] [path]", file=sys.stderr)
        return 2
    root = Path(arguments[0]).resolve() if arguments else Path.cwd()
    if init:
        for outcome in init_workspace(root):
            print(outcome)
    if not root.is_dir():
        print(f"error: no directory {root}", file=sys.stderr)
        return 1
    try:
        config = load_config(root)
    except ValueError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    findings = run_checks(root, config)
    for finding in findings:
        print(f"{finding.severity}: {finding.message}")
    errors = sum(1 for finding in findings if finding.severity == "error")
    warnings = sum(1 for finding in findings if finding.severity == "warning")
    print(f"{root}: {errors} errors, {warnings} warnings")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
